Import('*')

if env['CONF']['BUILD_ISA']:
    SimObject('SignalSmokeTest.py', sim_objects=['SignalSmokeTest'])
    SimObject('SignalCPU.py', sim_objects=['SignalCPU'])

    Source('signal.cc')
    Source('signal_smoke_test.cc')
    Source('signal_cpu.cc')
    Source('pipeline.cc')
    Source('fetch.cc')
    Source('decode.cc')
    Source('execute.cc')
    Source('alu_fu.cc')
    Source('lsq.cc')
    Source('stats.cc')

    DebugFlag('Signal3CPU',
              'Top-level signal-3-stage CPU events: cycle boundaries, '
              'halt, startup phase routing')
    DebugFlag('Signal3CPUPipeline',
              'Settle iterations, dirty stages, convergence, '
              'onAsyncResponse mid-cycle invocations')
    DebugFlag('Signal3CPUFetch',
              'F stage state per cycle: fetchPc, FIFO, in-flight, '
              'redirects applied, packets built')
    DebugFlag('Signal3CPUDecode',
              'D stage state per cycle: dSlot, decoded inst, branch '
              'resolution, redirects emitted')
    DebugFlag('Signal3CPUExecute',
              'E stage state per cycle: eSlot, LSQ transitions, '
              'flags, redirects, retired insts')
    DebugFlag('Signal3CPUSignal',
              'Every Signal<T>::write that changes value: signal name, '
              'old->new, subscribers re-queued')
    DebugFlag('Signal3CPULatch',
              'Every Latch<T>::commitEdge: latch name, sampled value, '
              'whether output changed')
    DebugFlag('Signal3CPUMem',
              'Memory: requests sent (port, addr, streamId), responses '
              'received (arrival tick, sameCycle classification)')
    DebugFlag('Signal3CPULineTrace',
              'Pretty-table cycle trace: one row per cycle showing the '
              'end-of-cycle state of fetch / decode / execute.')
    DebugFlag('Signal3CPULineTraceDetail',
              'Detailed within-cycle table: one row per Settle event '
              '(decode, accept, redirect, commit, queue, etc.) showing '
              'the post-event snapshot of fetch / decode / execute.')
    DebugFlag('Signal3CPUClockGate',
              'Clock-gating decisions: idle stops at end of evaluate '
              'when no stage will need work next cycle, and wake-ups '
              'from icache/dcache port callbacks (resp + retry).')
    DebugFlag('Signal3CPUFlagsFwd',
              'E->D NZCV forwarding (e_flags_to_d) and D-side cond '
              'branch resolution: pre/post ALU exec CC regs, fwd flags '
              'pulse values, decode-only resolve checks.')

    CompoundFlag('Signal3CPUAll',
                 ['Signal3CPU', 'Signal3CPUPipeline',
                  'Signal3CPUFetch', 'Signal3CPUDecode',
                  'Signal3CPUExecute', 'Signal3CPUSignal',
                  'Signal3CPULatch', 'Signal3CPUMem',
                  'Signal3CPULineTrace', 'Signal3CPULineTraceDetail',
                  'Signal3CPUFlagsFwd'])
